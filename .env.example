# Real-time sync between the big screen and the host phones over the internet (Supabase Realtime BROADCAST).
# Anon key only. No tables, no auth: Supabase just relays messages and stores nothing.
# Without these, the phone only syncs with a big screen open in the SAME browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
